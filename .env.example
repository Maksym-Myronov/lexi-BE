NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL in Docker (see docker-compose.yml). Start it with: pnpm db:up
DATABASE_URL="postgresql://lexi:lexi@localhost:5433/lexi_dev?schema=public"
# Used by e2e tests
DATABASE_URL_TEST="postgresql://lexi:lexi@localhost:5433/lexi_test?schema=public"

# At least 32 characters each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# The frontend's URL (allowed by CORS)
CORS_ORIGIN="http://localhost:3000"

# The admin account created by the seed script (BE-04)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
